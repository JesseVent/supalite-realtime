{
  "name": "@jessevent/supalite-realtime",
  "version": "0.0.0",
  "description": "Supabase Realtime transport (broadcast + presence) for @supabase/lite apps.",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@hono/node-server": "2.0.10",
    "@supabase/lite": "0.8.0",
    "@supabase/realtime-js": "2.97.0",
    "@types/ws": "8.18.1",
    "vitest": "4.1.11"
  }
}
